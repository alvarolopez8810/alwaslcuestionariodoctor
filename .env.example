# Copy to .env (gitignored) for local runs, or set in Render > Environment.
# Never commit real values.

# --- Access control (required for any hosted use) ---
AUDIT_APP_PASSWORD=
# Local review only: skip the password gate. Ignored when RENDER is set.
# AUDIT_ALLOW_NO_AUTH=1

# --- Storage: "sql" (default) or "sheets" ---
AUDIT_STORAGE_BACKEND=sql
# SQL: Postgres for hosting, e.g. postgresql://user:pass@host:5432/db
# Leave empty locally to use ~/.alwasl_process_audit/submissions.db (SQLite, outside the repo)
AUDIT_DATABASE_URL=
# Sheets:
# AUDIT_SHEET_ID=
# GOOGLE_SHEETS_CREDENTIALS_JSON=      # full service-account JSON on one line (hosting)
# GOOGLE_SHEETS_CREDENTIALS_FILE=      # path to the JSON key (local)

# --- Email (optional; if missing, submissions are still saved + downloadable) ---
AUDIT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
